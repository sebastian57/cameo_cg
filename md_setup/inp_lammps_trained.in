# Parameters are supplied by submit_lammps_chemtrain.sh via LAMMPS -var.
units           real
atom_style      atomic
dimension       3
boundary        s s s

neighbor        2.0 bin
neigh_modify    every 1 delay 0 check yes once no

read_data       ${data_file}
mass            * 12.01

# pair_style chemtrain_deploy <backend> <memory_fraction>
# pair_coeff * * <model_path> <ghost_buffer_multiplier> <edge_buffer_multiplier>
comm_modify     cutoff 14.0
pair_style      chemtrain_deploy cuda12 0.9
pair_coeff      * * ${model_file} 1.2 1.1

thermo_style    custom step temp pe ke etotal press vol density
thermo          10

velocity        all create ${temperature} 4928459 rot no dist gaussian
fix             1 all nvt temp ${temperature} ${temperature} 200.0
timestep        ${timestep_fs}

dump            traj all custom 100 ${dump_file} id type x y z fx fy fz
dump_modify     traj sort id

run             ${run_steps}
